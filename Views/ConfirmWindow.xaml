<Window x:Class="Visits11.Views.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подтверждение"
        Width="520" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="{StaticResource Font.Default}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border Margin="18" CornerRadius="20"
            Background="{DynamicResource Brush.Panel}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
            Effect="{StaticResource Effect.ShadowLg}" Padding="28">
        <StackPanel>
            <TextBlock x:Name="TitleText" Style="{StaticResource Txt.H2}" TextWrapping="Wrap" />
            <TextBlock x:Name="MessageText" Margin="0,8,0,0" Style="{StaticResource Txt.Dim}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="ExtraButton" Style="{StaticResource Btn.Soft}" Margin="0,0,8,0" Padding="14,0" Click="Extra_Click" />
                <Button x:Name="CancelButton" Content="Отмена" Style="{StaticResource Btn.Ghost}" Margin="0,0,8,0" Padding="14,0" IsCancel="True" />
                <Button x:Name="OkButton" Style="{StaticResource Btn.Primary}" Padding="16,0" IsDefault="True" Click="Ok_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
