<Window x:Class="Visits11.Views.SummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сводка семестра"
        Width="980" Height="640"
        WindowStyle="SingleBorderWindow"
        Background="{DynamicResource Brush.Bg}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinWidth="720" MinHeight="420"
        ShowInTaskbar="False"
        FontFamily="{StaticResource Font.Default}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border Background="{DynamicResource Brush.Panel}" Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" Style="{StaticResource Txt.H2}" TextWrapping="Wrap"
                       MouseLeftButtonDown="Title_OnMouseLeftButtonDown" />
            <TextBlock Grid.Row="1" Margin="0,8,0,12" TextWrapping="Wrap" Style="{StaticResource Txt.Dim}"
                       Text="+ был, н не был, — ещё не числился в группе. Полная таблица сохраняется в CSV." />
            <DataGrid x:Name="Grid" Grid.Row="2"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      Background="Transparent"
                      Foreground="{DynamicResource Brush.Text}"
                      FontFamily="{StaticResource Font.Default}"
                      FontSize="13"
                      RowBackground="{DynamicResource Brush.Panel}"
                      AlternatingRowBackground="{DynamicResource Brush.Panel3}"
                      HorizontalGridLinesBrush="{DynamicResource Brush.Border}">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource Brush.Panel3}" />
                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextDim}" />
                        <Setter Property="FontFamily" Value="{StaticResource Font.Medium}" />
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
            </DataGrid>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Сохранить CSV" Style="{StaticResource Btn.Violet}" Padding="16,0" Margin="0,0,8,0" Click="Save_Click" />
                <Button Content="Закрыть" Style="{StaticResource Btn.Ghost}" Padding="16,0" IsCancel="True" Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
