<Window x:Class="Visits11.Views.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Журнал КубГАУ"
        Width="440" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        FontFamily="{StaticResource Font.Default}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border Margin="18" CornerRadius="20"
            Background="{DynamicResource Brush.Panel}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
            Effect="{StaticResource Effect.ShadowLg}" Padding="28">
        <StackPanel>
            <TextBlock Text="Журнал КубГАУ" Style="{StaticResource Txt.H2}" />
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource Txt.Dim}"
                       Text="Система автоматизированной переклички. Введите ПИН преподавателя." />
            <TextBlock x:Name="Hint" Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource Txt.Dim}"
                       Text="Если ПИН не меняли — 2468." />
            <TextBox x:Name="PinBox" Margin="0,16,0,0" Style="{StaticResource Widget.Input}" MaxLength="4" />
            <Button Margin="0,16,0,0" Content="Открыть" Style="{StaticResource Btn.Primary}" IsDefault="True" Click="Ok_Click" />
            <Button Margin="0,8,0,0" Content="Выход" Style="{StaticResource Btn.Ghost}" IsCancel="True" />
        </StackPanel>
    </Border>
</Window>
