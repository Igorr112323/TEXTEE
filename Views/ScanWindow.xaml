<Window x:Class="Visits11.Views.ScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Считать итог"
        Width="720" Height="620"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        KeyDown="Window_OnKeyDown">
    <Border Margin="18" CornerRadius="20"
            Background="{DynamicResource Brush.Panel}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
            Effect="{StaticResource Effect.ShadowLg}" Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Считать итог с телефона" Style="{StaticResource Txt.H2}"
                       MouseLeftButtonDown="Title_OnMouseLeftButtonDown" />
            <Border Grid.Row="1" Margin="0,14,0,0" CornerRadius="16" Background="#111111" ClipToBounds="True">
                <Image x:Name="Preview" Stretch="Uniform" />
            </Border>
            <TextBlock x:Name="Status" Grid.Row="2" Margin="0,12,0,0" TextWrapping="Wrap"
                       Style="{StaticResource Txt.Dim}"
                       Text="Наведите камеру ПК на QR итога на телефоне преподавателя." />
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Импорт файла" Style="{StaticResource Btn.Ghost}" MinWidth="140"
                        Click="Import_Click" />
                <Button Content="Закрыть" Style="{StaticResource Btn.Primary}" MinWidth="130" Margin="10,0,0,0"
                        Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
